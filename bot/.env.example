# Ruang bot config. Copy to `.env` and fill in when you're ready.

# Your WhatsApp number in E.164 WITHOUT the + (e.g. 6281234567890).
# Only needed for pairing-code login. Leave blank to log in by scanning a QR.
OWNER_NUMBER=

# The group chats Ruang is allowed to watch, as a comma-separated list of JIDs
# (they look like 1203630XXXXXXXXX@g.us). Run `npm run groups` after linking to
# print the JID of every group you're in, then paste the ones you want here.
# RULE: if this is empty, Ruang watches NOTHING. It never listens to a group
# you didn't explicitly list.
WATCHED_GROUPS=

# pino log level: trace|debug|info|warn|error|silent
LOG_LEVEL=info

# Testing only: react to messages you send from your OWN account too, so you can
# trigger the bot solo. Set false for the real demo (invites come from others).
LISTEN_TO_SELF=false

# Port for the local API the Ruang app talks to (schedule sync + in-app approvals).
BOT_PORT=8788

# Shared secret for the bot API. If set, every /pending /decide /schedule /groups
# /say call must send it as `Authorization: Bearer <token>`. Leave blank = open,
# which is fine on localhost and is the default.
#
# Worth knowing before you rely on it: two routes can post to a group — /decide
# (with decision:"custom", verbatim text) and /say — and /pending hands out the
# ids /decide needs. So a blank token means anything that can reach the port can
# post to a watched group. Also, the app inlines its matching VITE_BOT_TOKEN
# into the browser bundle, so the token is not a secret from anyone who can load
# the app. It protects the port, not the app.
BOT_AUTH_TOKEN=
