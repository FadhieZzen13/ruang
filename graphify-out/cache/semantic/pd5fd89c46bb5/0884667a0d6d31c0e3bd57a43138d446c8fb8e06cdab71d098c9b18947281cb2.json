{"nodes": [{"id": "docs_design_signature_move", "label": "Signature Move", "file_type": "rationale", "source_file": "docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warm off-white + terracotta palette in clean Inter. Reads calm and modern; warmth comes from cream + terracotta, not a serif. Terracotta used sparingly \u2014 only the single primary action, today's date, and the conflict highlight \u2014 so every accent points at the one thing that matters."}, {"id": "docs_design_colour_tokens", "label": "Colour Tokens", "file_type": "concept", "source_file": "docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_type_tokens", "label": "Typography Tokens", "file_type": "concept", "source_file": "docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One typeface everywhere (Inter). The old Fraunces/Instrument Sans serif pairing was dropped \u2014 read as too 'editorial notebook' and not the crisp app feel wanted."}, {"id": "docs_design_inter_typeface", "label": "Inter Typeface", "file_type": "concept", "source_file": "docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_free_busy_state", "label": "Free/Busy Colour Rule", "file_type": "rationale", "source_file": "docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free/busy uses sage for clear and terracotta/amber for conflict \u2014 never red/green traffic-light harshness. Red/green rejected as too 'todo app'; sage + amber keeps the editorial feel."}, {"id": "docs_design_phone_frame", "label": "Phone Frame Mockup", "file_type": "concept", "source_file": "docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary device is a ~390x844 phone frame on a warm neutral backdrop so it screen-mirrors cleanly on a projector. A pure native shell was rejected \u2014 a PWA in a phone frame is enough to demo and screen-mirror."}, {"id": "docs_design_trust_line", "label": "Trust Line", "file_type": "concept", "source_file": "docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The line 'It proposes. You decide.' is always visible at a confirm step \u2014 reinforces the agent proposes but the user decides."}, {"id": "docs_design_dark_mode_rejected", "label": "Dark Mode (Rejected)", "file_type": "rationale", "source_file": "docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected \u2014 the brand is cream/editorial; dark mode would double the token surface for no demo gain."}], "edges": [{"source": "docs_design_colour_tokens", "target": "docs_design_signature_move", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_type_tokens", "target": "docs_design_inter_typeface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_signature_move", "target": "docs_design_inter_typeface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_free_busy_state", "target": "docs_design_colour_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_free_busy_state", "target": "docs_features_scheduler_day_agenda", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/design.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_phone_frame", "target": "docs_requirements_pwa_stack", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/design.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_trust_line", "target": "ruang_readme_llm_agent", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/design.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "warm_editorial_design_system", "label": "Warm Editorial Design System", "nodes": ["docs_design_signature_move", "docs_design_colour_tokens", "docs_design_inter_typeface", "docs_design_free_busy_state"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/design.md"}]}