# The Voice-tab agent calls OpenAI-compatible chat providers, tried in order:
# DeepSeek first, the gateway second. The browser can't call them directly
# (CORS), so the Vite dev server proxies /deepseek/* and /llm/* upstream and
# injects each key server-side — keys never ship to the browser.
# Copy this to `.env` and fill in your keys.

# PRIMARY — DeepSeek (server-side only). Add a key to make it primary:
DEEPSEEK_UPSTREAM=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-key-here
VITE_DEEPSEEK_MODEL=deepseek-chat

# FALLBACK — the existing gateway (used when DeepSeek is missing/failing):
LLM_UPSTREAM=https://rootsys.cloud/v1
LLM_API_KEY=your-key-here
VITE_LLM_MODEL=kimi-k2.7


# Where the Ruang WhatsApp bot's local API lives (for schedule sync + in-app
# invite approvals). Defaults to the bot's localhost port; only set this if you
# changed BOT_PORT in bot/.env or run the bot elsewhere.
# VITE_BOT_URL=http://localhost:8788

# Shared secret matching BOT_AUTH_TOKEN in bot/.env. Sent as an Authorization
# header so the frontend can talk to a published (Cloudflare) bot API privately.
# Only needed if you set BOT_AUTH_TOKEN on the bot. Note that anything VITE_* is
# inlined into the browser bundle, so this is not secret from app users.
# VITE_BOT_TOKEN=

# Transcription needs NO key — it uses the browser's built-in speech
# recognition (Chrome/Edge). No Python sidecar.
#
# NOTE: the proxy only runs under `npm run dev`. For a static production
# build, put the gateway call behind a real backend instead.
